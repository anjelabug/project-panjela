<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Project Panopoly · Round 1</title>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=IM+Fell+English:ital@0;1&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
<style>
:root {
  --purple:    #6B2D8B;  /* 🪻 Dark Purple · Drugstore */
  --magenta:   #D93A96;  /* 🌸 Magenta · Masstige */
  --yellow:    #F9E84C;  /* 🌟 Yellow · Mid-range */
  --green:     #00A950;  /* 🌿 Green · High-end */
  --red:       #ED1B24;  /* 🍷 Red · Prestige */
  --darkblue:  #1B3A8C;  /* 🦋 Dark Blue · Luxury */

  --card-bg:   #F5F0E8;
  --card-body: #FDFAF5;
  --ink:       #1A1614;
  --ink-mid:   #3D3530;
  --ink-light: #7A6E68;
  --rule:      #C8BFB0;
  --page-bg:   #BFDBAE;
  --gold:      #B8962A;
  --gold-light:#E8C84A;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'DM Mono', monospace;
  background: var(--page-bg);
  background-image:
    repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(0,0,0,0.04) 39px, rgba(0,0,0,0.04) 40px),
    repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(0,0,0,0.04) 39px, rgba(0,0,0,0.04) 40px);
  min-height: 100vh;
  padding: 1.5rem 1rem 5rem;
  color: var(--ink);
}

/* ── NAV ── */
.nav-links { display: flex; justify-content: center; gap: 1rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
.nav-link { font-family: 'Libre Baskerville', serif; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); background: rgba(255,255,255,0.5); border: 1.5px solid rgba(0,0,0,0.2); padding: 0.3rem 0.8rem; border-radius: 2px; text-decoration: none; transition: background 0.15s; }
.nav-link:hover { background: rgba(255,255,255,0.8); }

/* ── HEADER ── */
.page-header { text-align: center; margin-bottom: 2rem; }
.page-title { font-family: 'IM Fell English', serif; font-size: 2.2rem; color: #1A1614; letter-spacing: 0.04em; text-shadow: 0 1px 4px rgba(255,255,255,0.3); line-height: 1.1; }
.page-title span { font-style: italic; color: #2C5C1A; }
.page-sub { font-size: 0.55rem; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(26,22,20,0.55); margin-top: 0.4rem; }
.page-sub a { color: rgba(26,22,20,0.5); text-decoration: none; }
.round-badge { display: inline-block; font-family: 'Libre Baskerville', serif; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #FDFAF5; background: #2C5C1A; padding: 0.25rem 0.9rem; margin-top: 0.8rem; border-radius: 2px; }

/* ── ROUND SUMMARY ── */
.round-summary { background: rgba(255,255,255,0.35); border: 1px solid rgba(0,0,0,0.15); padding: 0.9rem 1rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; }
.round-summary-label { font-size: 0.52rem; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(26,22,20,0.5); white-space: nowrap; }
.round-summary-bar-wrap { flex: 1; height: 3px; background: rgba(0,0,0,0.15); overflow: hidden; }
.round-summary-bar { height: 100%; background: linear-gradient(90deg, #2C5C1A, #4A8C2A); transition: width 0.4s ease; }
.round-summary-pct { font-family: 'IM Fell English', serif; font-size: 0.9rem; color: #2C5C1A; white-space: nowrap; }

/* ── COLOR GROUP HEADER ── */
.color-group-header { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; margin-top: 1.5rem; }
.color-group-swatch { width: 18px; height: 18px; border: 2px solid rgba(0,0,0,0.2); flex-shrink: 0; }
.color-group-name { font-family: 'Libre Baskerville', serif; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(26,22,20,0.6); }
.color-group-status { font-size: 0.52rem; color: rgba(26,22,20,0.45); letter-spacing: 0.08em; margin-left: auto; }

/* ── PROPERTY CARD ── */
.property-card { background: var(--card-body); border: 2px solid var(--ink); border-radius: 4px; margin-bottom: 1.2rem; box-shadow: 3px 3px 0 rgba(0,0,0,0.5), 0 6px 20px rgba(0,0,0,0.2); overflow: hidden; }
.property-card.complete { box-shadow: 3px 3px 0 rgba(0,0,0,0.5), 0 0 0 3px var(--gold-light), 0 6px 24px rgba(184,150,42,0.2); }

.deed-color-bar { padding: 0.55rem 0.9rem 0.5rem; display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none; -webkit-tap-highlight-color: transparent; }
.deed-color-bar .group-label { font-family: 'Libre Baskerville', serif; font-size: 0.58rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; line-height: 1.2; }
.deed-color-bar .property-name { font-family: 'Libre Baskerville', serif; font-size: 0.88rem; font-weight: 700; line-height: 1.2; margin-top: 0.1rem; }
.deed-color-bar .chevron { font-size: 0.8rem; transition: transform 0.2s; flex-shrink: 0; margin-left: 0.5rem; }
.property-card.open .deed-color-bar .chevron { transform: rotate(180deg); }

.bar-purple   { background: var(--purple);   color: #fff; }
.bar-magenta  { background: var(--magenta);  color: #fff; }
.bar-yellow   { background: var(--yellow);   color: var(--ink); }
.bar-green    { background: var(--green);    color: #fff; }
.bar-red      { background: var(--red);      color: #fff; }
.bar-darkblue { background: var(--darkblue); color: #fff; }

.deed-header { border-bottom: 2px solid var(--ink); padding: 0.65rem 0.9rem 0.6rem; }
.deed-title { font-family: 'Libre Baskerville', serif; font-size: 1.05rem; font-weight: 700; color: var(--ink); line-height: 1.2; text-align: center; text-transform: uppercase; letter-spacing: 0.04em; }
.deed-subtitle { font-family: 'Libre Baskerville', serif; font-size: 0.6rem; font-style: italic; color: var(--ink-mid); text-align: center; margin-top: 0.15rem; }
.deed-progress-wrap { margin-top: 0.55rem; display: flex; align-items: center; gap: 0.5rem; }
.deed-progress-track { flex: 1; height: 5px; background: #D8D0C4; border: 1px solid #B8B0A4; overflow: hidden; }
.deed-progress-fill { height: 100%; transition: width 0.4s ease; }
.deed-progress-count { font-size: 0.55rem; color: var(--ink-light); white-space: nowrap; letter-spacing: 0.04em; }
.deed-buildings { margin-top: 0.4rem; font-size: 0.75rem; letter-spacing: 0.05em; min-height: 1.2rem; }

.deed-body { display: none; border-top: 1px solid var(--rule); }
.property-card.open .deed-body { display: block; }
.deed-section { padding: 0.75rem 0.9rem; border-bottom: 1px solid var(--rule); }
.deed-section:last-child { border-bottom: none; }
.deed-section-label { font-size: 0.5rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-light); margin-bottom: 0.45rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.25rem; }
.deed-description { font-family: 'Libre Baskerville', serif; font-size: 0.8rem; font-style: italic; color: var(--ink-mid); line-height: 1.5; }
.deed-detail { font-family: 'DM Mono', monospace; font-size: 0.6rem; color: var(--ink-light); line-height: 1.5; margin-top: 0.4rem; padding: 0.4rem 0.6rem; background: #EDE8E0; border-left: 2px solid var(--rule); }
.deed-grid { display: grid; grid-template-columns: auto 1fr; gap: 0.2rem 0.7rem; }
.deed-grid-label { font-size: 0.58rem; color: var(--ink-light); letter-spacing: 0.04em; white-space: nowrap; }
.deed-grid-value { font-family: 'Libre Baskerville', serif; font-size: 0.78rem; color: var(--ink); }

.deed-counter-wrap { display: flex; align-items: center; gap: 0.8rem; }
.deed-btn { width: 34px; height: 34px; border: 2px solid var(--ink); background: var(--card-bg); font-size: 1.2rem; font-family: 'Libre Baskerville', serif; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--ink); transition: background 0.1s; -webkit-tap-highlight-color: transparent; }
.deed-btn:active { background: #DDD8CE; }
.deed-counter-display { flex: 1; text-align: center; }
.deed-counter-number { font-family: 'IM Fell English', serif; font-size: 2.2rem; color: var(--ink); line-height: 1; }
.deed-counter-target { font-size: 0.55rem; color: var(--ink-light); letter-spacing: 0.08em; margin-top: 0.1rem; }
.deed-last-used { font-size: 0.58rem; color: var(--ink-light); text-align: center; margin-top: 0.4rem; font-style: italic; }
.deed-full-progress { margin-top: 0.5rem; }
.deed-full-track { height: 8px; background: #D8D0C4; border: 1px solid var(--ink); }
.deed-full-fill { height: 100%; transition: width 0.4s ease; }
.deed-full-labels { display: flex; justify-content: space-between; font-size: 0.52rem; color: var(--ink-light); margin-top: 0.2rem; }

.deed-notes-log { max-height: 180px; overflow-y: auto; margin-bottom: 0.6rem; }
.deed-note-entry { padding: 0.4rem 0; border-bottom: 1px solid var(--rule); display: flex; gap: 0.6rem; align-items: flex-start; }
.deed-note-entry:last-child { border-bottom: none; }
.deed-note-ts { font-size: 0.5rem; color: var(--ink-light); white-space: nowrap; margin-top: 2px; flex-shrink: 0; }
.deed-note-text { font-family: 'Libre Baskerville', serif; font-size: 0.78rem; color: var(--ink); line-height: 1.4; }
.deed-note-empty { font-size: 0.6rem; color: var(--ink-light); font-style: italic; text-align: center; padding: 0.4rem 0; }
.deed-note-row { display: flex; gap: 0.4rem; align-items: flex-end; }
.deed-note-input { flex: 1; font-family: 'Libre Baskerville', serif; font-size: 0.8rem; color: var(--ink); background: #EDE8E0; border: 1px solid var(--rule); padding: 0.4rem 0.6rem; resize: none; min-height: 48px; line-height: 1.4; }
.deed-note-input:focus { outline: none; border-color: var(--ink); }
.deed-note-input::placeholder { color: var(--ink-light); font-style: italic; }
.deed-note-submit { font-family: 'Libre Baskerville', serif; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--card-bg); background: var(--ink); border: none; padding: 0.5rem 0.7rem; cursor: pointer; -webkit-tap-highlight-color: transparent; }
.deed-note-submit:active { background: var(--ink-mid); }

.deed-complete { display: none; background: linear-gradient(135deg, rgba(184,150,42,0.12), rgba(184,150,42,0.04)); border-top: 2px solid var(--ink); padding: 0.7rem 0.9rem; text-align: center; }
.property-card.complete .deed-complete { display: block; }
.deed-complete-msg { font-family: 'IM Fell English', serif; font-size: 0.95rem; color: var(--ink); letter-spacing: 0.04em; }
.deed-complete-sub { font-size: 0.55rem; color: var(--ink-light); letter-spacing: 0.1em; text-transform: uppercase; margin-top: 0.2rem; }

/* ── COLLECTED SECTION ── */
.collected-section { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(0,0,0,0.12); }
.collected-caption { font-family: 'Libre Baskerville', serif; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(26,22,20,0.5); text-align: center; margin-bottom: 1.2rem; }
.collected-table { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }

.collected-card { width: 96px; background: var(--card-body); border: 2px solid var(--ink); border-radius: 3px; box-shadow: 2px 3px 0 rgba(0,0,0,0.35), 0 4px 12px rgba(0,0,0,0.15); cursor: pointer; transition: transform 0.18s, box-shadow 0.18s; display: flex; flex-direction: column; align-items: stretch; overflow: hidden; -webkit-tap-highlight-color: transparent; }
.collected-card:hover { transform: translateY(-3px) rotate(-1deg); box-shadow: 3px 5px 0 rgba(0,0,0,0.35), 0 8px 20px rgba(0,0,0,0.2); }
.cc-color-bar { height: 18px; flex-shrink: 0; }
.cc-body { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0.5rem 0.3rem; }
.cc-challenge { font-family: 'Libre Baskerville', serif; font-size: 0.42rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; text-align: center; color: var(--ink); line-height: 1.3; }
.cc-product { font-family: 'Libre Baskerville', serif; font-size: 0.38rem; font-style: italic; color: var(--ink-mid); text-align: center; line-height: 1.3; margin-top: 0.15rem; padding: 0 0.1rem; }
.cc-brand { font-family: 'DM Mono', monospace; font-size: 0.34rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-light); text-align: center; margin-top: 0.2rem; }
.cc-stamp { font-family: 'IM Fell English', serif; font-size: 0.6rem; color: var(--ink-light); margin-top: 0.25rem; }

/* ── PANOPOLY BOX ── */
.panopoly-box {
  border: 2px solid var(--ink);
  background: #FEFCE8;
  border-radius: 4px;
  padding: 0.8rem;
  width: 100%;
  margin-top: 0.5rem;
}
.panopoly-box-title {
  font-family: 'IM Fell English', serif;
  font-size: 0.85rem;
  color: var(--ink);
  text-align: center;
  margin-bottom: 0.6rem;
  letter-spacing: 0.04em;
}
.panopoly-box-cards {
  display: flex;
  gap: 0.6rem;
  justify-content: center;
  flex-wrap: wrap;
}
.cc-modal-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 200; align-items: center; justify-content: center; padding: 1rem; }
.cc-modal-backdrop.open { display: flex; }
.cc-modal { background: var(--card-body); border: 2px solid var(--ink); border-radius: 4px; max-width: 320px; width: 100%; box-shadow: 4px 4px 0 rgba(0,0,0,0.4), 0 12px 40px rgba(0,0,0,0.4); position: relative; overflow: hidden; }
.cc-modal-bar { height: 24px; width: 100%; }
.cc-modal-inner { padding: 1.1rem 1.2rem 1rem; }
.cc-modal-close { position: absolute; top: 0.4rem; right: 0.6rem; font-size: 1rem; color: rgba(255,255,255,0.7); cursor: pointer; background: none; border: none; line-height: 1; z-index: 10; }
.cc-modal-brand { font-family: 'DM Mono', monospace; font-size: 0.5rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ink-light); }
.cc-modal-title { font-family: 'Libre Baskerville', serif; font-size: 1.05rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink); margin: 0.15rem 0 0.05rem; }
.cc-modal-product { font-family: 'Libre Baskerville', serif; font-size: 0.8rem; font-style: italic; color: var(--ink-mid); margin-bottom: 0.7rem; }
.cc-modal-divider { border: none; border-top: 1px solid var(--rule); margin: 0.7rem 0; }
.cc-modal-detail-label { font-size: 0.48rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-light); margin-bottom: 0.15rem; }
.cc-modal-detail-value { font-family: 'Libre Baskerville', serif; font-size: 0.82rem; color: var(--ink); margin-bottom: 0.5rem; }
.cc-modal-badge { display: inline-block; font-family: 'IM Fell English', serif; font-size: 0.7rem; color: var(--ink); border: 1.5px solid var(--ink); padding: 0.15rem 0.5rem; margin-top: 0.3rem; letter-spacing: 0.04em; }

/* ── CONFETTI ── */
.confetti-container { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1000; overflow: hidden; }
.confetti-piece { position: absolute; top: -10px; animation: confettiFall linear forwards; }
@keyframes confettiFall { 0% { transform: translateY(0) rotate(0deg); opacity: 1; } 85% { opacity: 1; } 100% { transform: translateY(110vh) rotate(540deg); opacity: 0; } }
</style>
</head>
<body>

<div class="confetti-container" id="confettiContainer"></div>

<!-- MODAL -->
<div class="cc-modal-backdrop" id="ccModalBackdrop" onclick="closeModal(event)">
  <div class="cc-modal">
    <div class="cc-modal-bar" id="ccModalBar"></div>
    <button class="cc-modal-close" onclick="closeModalBtn()">✕</button>
    <div class="cc-modal-inner">
      <div id="ccModalBrand" class="cc-modal-brand"></div>
      <div id="ccModalTitle" class="cc-modal-title"></div>
      <div id="ccModalProduct" class="cc-modal-product"></div>
      <hr class="cc-modal-divider">
      <div class="cc-modal-detail-label">Notes</div>
      <div id="ccModalNotes" class="cc-modal-detail-value"></div>
      <div class="cc-modal-detail-label">Completed</div>
      <div id="ccModalDate" class="cc-modal-detail-value"></div>
      <div><span class="cc-modal-badge">✦ Challenge Complete ✦</span></div>
    </div>
  </div>
</div>

<!-- NAV -->
<div class="nav-links">
  <a class="nav-link" href="https://anjelabug.github.io/project-panjela/">← Project Panjela</a>
  <a class="nav-link" href="https://sites.google.com/view/projectpanopoly" target="_blank">Panopoly Rules ↗</a>
</div>

<!-- HEADER -->
<header class="page-header">
  <div class="page-title">Project <span>Panopoly</span></div>
  <div class="page-sub">A Panning Challenge · Created by Jami · <a href="https://www.youtube.com/@theimpulsivepanner" target="_blank">@theimpulsivepanner</a> on YouTube</div>
  <div class="round-badge">Round 1</div>
</header>

<!-- OVERALL -->
<div class="round-summary">
  <div class="round-summary-label">Round Progress</div>
  <div class="round-summary-bar-wrap"><div class="round-summary-bar" id="overallBar"></div></div>
  <div class="round-summary-pct" id="overallPct">—</div>
</div>

<!-- ══ 🪻 PURPLE · Wheel 1 · Gleam & Glow / Color Flash ══ -->
<div class="color-group-header">
  <div class="color-group-swatch" style="background:var(--purple)"></div>
  <div class="color-group-name">🪻 Gleam & Glow · Color Flash · Wheel 1</div>
  <div class="color-group-status">1 collected when complete</div>
</div>

<div class="property-card" id="card-hair">
  <div class="deed-color-bar bar-purple" onclick="toggleCard('hair')">
    <div><div class="group-label">Wheel 1 · Skincare / Body / Hair</div><div class="property-name">Color Flash</div></div>
    <div class="chevron">▾</div>
  </div>
  <div class="deed-header">
    <div class="deed-title">Haircare</div>
    <div class="deed-subtitle">Batiste · Dry Powder Shampoo · Dark</div>
    <div class="deed-buildings" id="buildings-hair"></div>
    <div class="deed-progress-wrap">
      <div class="deed-progress-track"><div class="deed-progress-fill" id="bar-hair" style="background:var(--purple);width:0%"></div></div>
      <div class="deed-progress-count" id="count-hair">0 / 3</div>
    </div>
  </div>
  <div class="deed-body">
    <div class="deed-section">
      <div class="deed-section-label">Challenge</div>
      <div class="deed-description">Haircare — use and evaluate a haircare product across 3 applications.</div>
      <div class="deed-detail">Wheel 1 · 3 uses · The one I'm trying hardest to pan! No regrets on the repeat.</div>
    </div>
    <div class="deed-section">
      <div class="deed-section-label">Product Details</div>
      <div class="deed-grid">
        <div class="deed-grid-label">Brand</div><div class="deed-grid-value">Batiste</div>
        <div class="deed-grid-label">Product</div><div class="deed-grid-value">Dry Powder Shampoo</div>
        <div class="deed-grid-label">Shade/Scent</div><div class="deed-grid-value">Dark</div>
        <div class="deed-grid-label">Started</div><div class="deed-grid-value">5/28/2026</div>
      </div>
    </div>
    <div class="deed-section">
      <div class="deed-section-label">Uses · Target 3</div>
      <div class="deed-counter-wrap">
        <button class="deed-btn" onclick="adjustCount('hair',-1)">−</button>
        <div class="deed-counter-display"><div class="deed-counter-number" id="num-hair">0</div><div class="deed-counter-target">of 3 uses</div></div>
        <button class="deed-btn" onclick="adjustCount('hair',1)">+</button>
      </div>
      <div class="deed-last-used" id="last-hair"></div>
      <div class="deed-full-progress">
        <div class="deed-full-track"><div class="deed-full-fill" id="fill-hair" style="background:var(--purple);width:0%"></div></div>
        <div class="deed-full-labels"><span id="pct-hair">0%</span><span>3 uses</span></div>
      </div>
    </div>
    <div class="deed-section">
      <div class="deed-section-label">Notes Log</div>
      <div class="deed-notes-log" id="log-hair"><div class="deed-note-empty">No notes yet.</div></div>
      <div class="deed-note-row">
        <textarea class="deed-note-input" id="input-hair" placeholder="Add a note…" rows="2"></textarea>
        <button class="deed-note-submit" onclick="addNote('hair')">Add</button>
      </div>
    </div>
    <div class="deed-complete">
      <div class="deed-complete-msg">✦ Challenge Complete! ✦</div>
      <div class="deed-complete-sub">You're now the proud owner of Batiste Dark from the Color Flash collection! Roll again to find out what you'll collect next!</div>
    </div>
  </div>
</div>

<!-- ══ 🌸 MAGENTA · Wheel 2 · The Vivid Collection / Lumie / Face Forward ══ -->
<div class="color-group-header">
  <div class="color-group-swatch" style="background:var(--magenta)"></div>
  <div class="color-group-name">🌸 The Vivid Collection · Lumie · Face Forward · Wheel 2</div>
  <div class="color-group-status">2 collected when complete</div>
</div>

<div class="property-card" id="card-blush">
  <div class="deed-color-bar bar-magenta" onclick="toggleCard('blush')">
    <div><div class="group-label">Wheel 2 · Base Products</div><div class="property-name">The Vivid Collection</div></div>
    <div class="chevron">▾</div>
  </div>
  <div class="deed-header">
    <div class="deed-title">Blush</div>
    <div class="deed-subtitle">Rare Beauty · Soft Pinch Liquid Blush · Spirited</div>
    <div class="deed-buildings" id="buildings-blush"></div>
    <div class="deed-progress-wrap">

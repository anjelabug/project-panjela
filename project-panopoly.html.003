<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Project Panopoly · Round 1</title>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=IM+Fell+English:ital@0;1&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
<style>
/* ── MONOPOLY COLOR PALETTE ─────────────────────────────── */
:root {
  --brown:      #6B2D8B; /* dark purple / Mediterranean */
  --cyan:       #AAE0FA; /* light blue / Connecticut */
  --magenta:    #D93A96; /* pink / St. Charles */
  --orange:     #F7941D; /* orange / New York */
  --yellow:     #F9E84C; /* yellow / Marvin Gardens */
  --darkblue:   #1B3A8C; /* dark blue / Boardwalk */

  --card-bg:    #F5F0E8;
  --card-body:  #FDFAF5;
  --ink:        #1A1614;
  --ink-mid:    #3D3530;
  --ink-light:  #7A6E68;
  --rule:       #C8BFB0;
  --page-bg:    #2C2420;
  --page-mid:   #3A302A;

  --house-green: #2D7A3A;
  --hotel-red:   #C8102E;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'DM Mono', monospace;
  background: var(--page-bg);
  background-image:
    repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(255,255,255,0.03) 39px, rgba(255,255,255,0.03) 40px),
    repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(255,255,255,0.03) 39px, rgba(255,255,255,0.03) 40px);
  min-height: 100vh;
  padding: 1.5rem 1rem 5rem;
  color: var(--ink);
}

/* ── HEADER ── */
.page-header { text-align: center; margin-bottom: 2rem; }
.page-title { font-family: 'IM Fell English', serif; font-size: 2.2rem; color: #F5F0E8; letter-spacing: 0.04em; text-shadow: 0 2px 12px rgba(0,0,0,0.6); line-height: 1.1; }
.page-title span { font-style: italic; color: #F9E84C; }
.page-sub { font-size: 0.55rem; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(245,240,232,0.35); margin-top: 0.4rem; }
.page-links { display: flex; justify-content: center; gap: 1.2rem; margin-top: 0.6rem; flex-wrap: wrap; }
.page-link { font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(245,240,232,0.35); text-decoration: none; border-bottom: 1px solid rgba(245,240,232,0.15); padding-bottom: 1px; transition: color 0.2s, border-color 0.2s; }
.page-link:hover { color: var(--gold-light); border-color: var(--gold); }
.creator-credit { font-family: 'DM Mono', monospace; font-size: 0.5rem; color: rgba(245,240,232,0.22); letter-spacing: 0.1em; margin-top: 0.5rem; }
.creator-credit a { color: rgba(245,240,232,0.28); text-decoration: none; }
.creator-credit a:hover { color: var(--gold-light); }
.round-badge { display: inline-block; font-family: 'Libre Baskerville', serif; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--page-bg); background: #F5F0E8; padding: 0.25rem 0.9rem; margin-top: 0.8rem; border-radius: 2px; }

/* ── ROUND SUMMARY ── */
.round-summary { background: rgba(245,240,232,0.06); border: 1px solid rgba(245,240,232,0.12); padding: 0.9rem 1rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; }
.round-summary-label { font-size: 0.52rem; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(245,240,232,0.35); white-space: nowrap; }
.round-summary-bar-wrap { flex: 1; height: 3px; background: rgba(245,240,232,0.1); overflow: hidden; }
.round-summary-bar { height: 100%; background: linear-gradient(90deg, #F9E84C, #F7941D); transition: width 0.4s ease; }
.round-summary-pct { font-family: 'IM Fell English', serif; font-size: 0.9rem; color: #F9E84C; white-space: nowrap; }

/* ── COLOR GROUP HEADER ── */
.color-group-header { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; margin-top: 1.5rem; }
.color-group-swatch { width: 18px; height: 18px; border: 2px solid rgba(245,240,232,0.4); flex-shrink: 0; }
.color-group-name { font-family: 'Libre Baskerville', serif; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(245,240,232,0.5); }
.color-group-status { font-size: 0.52rem; color: rgba(245,240,232,0.3); letter-spacing: 0.08em; margin-left: auto; }

/* ── PROPERTY CARD ── */
.property-card { background: var(--card-body); border: 2px solid var(--ink); border-radius: 4px; margin-bottom: 1.2rem; box-shadow: 3px 3px 0 rgba(0,0,0,0.5), 0 6px 20px rgba(0,0,0,0.4); overflow: hidden; }
.property-card.complete { box-shadow: 3px 3px 0 rgba(0,0,0,0.5), 0 0 0 3px #F9E84C, 0 6px 24px rgba(249,232,76,0.25); }

.deed-color-bar { padding: 0.55rem 0.9rem 0.5rem; display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none; -webkit-tap-highlight-color: transparent; }
.deed-color-bar .group-label { font-family: 'Libre Baskerville', serif; font-size: 0.58rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; line-height: 1.2; }
.deed-color-bar .property-name { font-family: 'Libre Baskerville', serif; font-size: 0.88rem; font-weight: 700; line-height: 1.2; margin-top: 0.1rem; }
.deed-color-bar .chevron { font-size: 0.8rem; transition: transform 0.2s; flex-shrink: 0; margin-left: 0.5rem; }
.property-card.open .deed-color-bar .chevron { transform: rotate(180deg); }

.bar-brown    { background: var(--brown);   color: #fff; }
.bar-cyan     { background: var(--cyan);    color: var(--ink); }
.bar-magenta  { background: var(--magenta); color: #fff; }
.bar-orange   { background: var(--orange);  color: var(--ink); }
.bar-yellow   { background: var(--yellow);  color: var(--ink); }
.bar-darkblue { background: var(--darkblue);color: #fff; }

.deed-header { border-bottom: 2px solid var(--ink); padding: 0.65rem 0.9rem 0.6rem; }
.deed-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem; }
.deed-title { font-family: 'Libre Baskerville', serif; font-size: 1.05rem; font-weight: 700; color: var(--ink); line-height: 1.2; text-align: center; flex: 1; text-transform: uppercase; letter-spacing: 0.04em; }
.deed-subtitle { font-family: 'Libre Baskerville', serif; font-size: 0.6rem; font-style: italic; color: var(--ink-mid); text-align: center; margin-top: 0.15rem; }
.deed-progress-wrap { margin-top: 0.55rem; display: flex; align-items: center; gap: 0.5rem; }
.deed-progress-track { flex: 1; height: 5px; background: #D8D0C4; border: 1px solid #B8B0A4; overflow: hidden; }
.deed-progress-fill { height: 100%; transition: width 0.4s ease; }
.deed-progress-count { font-size: 0.55rem; color: var(--ink-light); white-space: nowrap; letter-spacing: 0.04em; }
.deed-buildings { margin-top: 0.4rem; font-size: 0.75rem; letter-spacing: 0.05em; min-height: 1.2rem; }

.deed-body { display: none; border-top: 1px solid var(--rule); }
.property-card.open .deed-body { display: block; }

.deed-section { padding: 0.75rem 0.9rem; border-bottom: 1px solid var(--rule); }
.deed-section:last-child { border-bottom: none; }
.deed-section-label { font-size: 0.5rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-light); margin-bottom: 0.45rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.25rem; }
.deed-description { font-family: 'Libre Baskerville', serif; font-size: 0.8rem; font-style: italic; color: var(--ink-mid); line-height: 1.5; }
.deed-detail { font-family: 'DM Mono', monospace; font-size: 0.6rem; color: var(--ink-light); line-height: 1.5; margin-top: 0.4rem; padding: 0.4rem 0.6rem; background: #EDE8E0; border-left: 2px solid var(--rule); }
.deed-grid { display: grid; grid-template-columns: auto 1fr; gap: 0.2rem 0.7rem; }
.deed-grid-label { font-size: 0.58rem; color: var(--ink-light); letter-spacing: 0.04em; white-space: nowrap; }
.deed-grid-value { font-family: 'Libre Baskerville', serif; font-size: 0.78rem; color: var(--ink); }

.deed-counter-wrap { display: flex; align-items: center; gap: 0.8rem; }
.deed-btn { width: 34px; height: 34px; border: 2px solid var(--ink); border-radius: 0; background: var(--card-bg); font-size: 1.2rem; font-family: 'Libre Baskerville', serif; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--ink); transition: background 0.1s; -webkit-tap-highlight-color: transparent; }
.deed-btn:active { background: #DDD8CE; }
.deed-counter-display { flex: 1; text-align: center; }
.deed-counter-number { font-family: 'IM Fell English', serif; font-size: 2.2rem; color: var(--ink); line-height: 1; }
.deed-counter-target { font-size: 0.55rem; color: var(--ink-light); letter-spacing: 0.08em; margin-top: 0.1rem; }
.deed-last-used { font-size: 0.58rem; color: var(--ink-light); text-align: center; margin-top: 0.4rem; font-style: italic; }
.deed-full-progress { margin-top: 0.5rem; }
.deed-full-track { height: 8px; background: #D8D0C4; border: 1px solid var(--ink); }
.deed-full-fill { height: 100%; transition: width 0.4s ease; }
.deed-full-labels { display: flex; justify-content: space-between; font-size: 0.52rem; color: var(--ink-light); margin-top: 0.2rem; }

.deed-notes-log { max-height: 180px; overflow-y: auto; margin-bottom: 0.6rem; }
.deed-note-entry { padding: 0.4rem 0; border-bottom: 1px solid var(--rule); display: flex; gap: 0.6rem; align-items: flex-start; }
.deed-note-entry:last-child { border-bottom: none; }
.deed-note-ts { font-size: 0.5rem; color: var(--ink-light); white-space: nowrap; margin-top: 2px; flex-shrink: 0; }
.deed-note-text { font-family: 'Libre Baskerville', serif; font-size: 0.78rem; color: var(--ink); line-height: 1.4; }
.deed-note-empty { font-size: 0.6rem; color: var(--ink-light); font-style: italic; text-align: center; padding: 0.4rem 0; }
.deed-note-row { display: flex; gap: 0.4rem; align-items: flex-end; }
.deed-note-input { flex: 1; font-family: 'Libre Baskerville', serif; font-size: 0.8rem; color: var(--ink); background: #EDE8E0; border: 1px solid var(--rule); padding: 0.4rem 0.6rem; resize: none; min-height: 48px; line-height: 1.4; }
.deed-note-input:focus { outline: none; border-color: var(--ink); }
.deed-note-input::placeholder { color: var(--ink-light); font-style: italic; }
.deed-note-submit { font-family: 'Libre Baskerville', serif; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--card-bg); background: var(--ink); border: none; padding: 0.5rem 0.7rem; cursor: pointer; -webkit-tap-highlight-color: transparent; }
.deed-note-submit:active { background: var(--ink-mid); }

.deed-complete { display: none; background: linear-gradient(135deg, rgba(249,232,76,0.12), rgba(249,232,76,0.04)); border-top: 2px solid var(--ink); padding: 0.7rem 0.9rem; text-align: center; }
.property-card.complete .deed-complete { display: block; }
.deed-complete-msg { font-family: 'IM Fell English', serif; font-size: 0.95rem; color: var(--ink); letter-spacing: 0.04em; }
.deed-complete-sub { font-size: 0.55rem; color: var(--ink-light); letter-spacing: 0.1em; text-transform: uppercase; margin-top: 0.2rem; }

/* ── COLLECTED SECTION ── */
.collected-section { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(245,240,232,0.08); }
.collected-caption { font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(245,240,232,0.3); text-align: center; margin-bottom: 1.2rem; }
.collected-table { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }

.collected-card {
  width: 96px; height: 134px;
  background: var(--card-body);
  border: 2px solid var(--ink);
  border-radius: 3px;
  box-shadow: 2px 4px 12px rgba(0,0,0,0.5), 3px 3px 0 rgba(0,0,0,0.3);
  position: relative;
  cursor: pointer;
  transition: transform 0.18s, box-shadow 0.18s;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  overflow: hidden;
  -webkit-tap-highlight-color: transparent;
}
.collected-card:hover { transform: translateY(-4px) rotate(-1deg); box-shadow: 4px 8px 20px rgba(0,0,0,0.6), 3px 3px 0 rgba(0,0,0,0.3); }
.cc-color-bar { height: 18px; flex-shrink: 0; }
.cc-body { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0.3rem 0.25rem; }
.cc-challenge { font-family: 'Libre Baskerville', serif; font-size: 0.42rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; text-align: center; color: var(--ink); line-height: 1.3; }
.cc-product { font-family: 'Libre Baskerville', serif; font-size: 0.38rem; font-style: italic; color: var(--ink-mid); text-align: center; line-height: 1.3; margin-top: 0.15rem; padding: 0 0.1rem; }
.cc-street { font-family: 'DM Mono', monospace; font-size: 0.34rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-light); text-align: center; margin-top: 0.2rem; }
.cc-stamp { font-family: 'IM Fell English', serif; font-size: 0.55rem; color: var(--ink-light); margin-top: 0.3rem; }

/* Collected modal */
.cc-modal-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); z-index: 200; align-items: center; justify-content: center; padding: 1rem; }
.cc-modal-backdrop.open { display: flex; }
.cc-modal { background: var(--card-body); border: 2px solid var(--ink); border-radius: 4px; max-width: 320px; width: 100%; box-shadow: 4px 4px 0 rgba(0,0,0,0.4), 0 12px 40px rgba(0,0,0,0.6); position: relative; overflow: hidden; }
.cc-modal-bar { height: 24px; width: 100%; }
.cc-modal-inner { padding: 1.1rem 1.2rem 1rem; }
.cc-modal-close { position: absolute; top: 0.5rem; right: 0.7rem; font-size: 1rem; color: rgba(245,240,232,0.7); cursor: pointer; background: none; border: none; line-height: 1; z-index: 10; }
.cc-modal-street { font-family: 'DM Mono', monospace; font-size: 0.5rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ink-light); }
.cc-modal-title { font-family: 'Libre Baskerville', serif; font-size: 1.05rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink); margin: 0.15rem 0 0.05rem; }
.cc-modal-product { font-family: 'Libre Baskerville', serif; font-size: 0.8rem; font-style: italic; color: var(--ink-mid); margin-bottom: 0.7rem; }
.cc-modal-divider { border: none; border-top: 1px solid var(--rule); margin: 0.7rem 0; }
.cc-modal-detail-label { font-size: 0.48rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-light); margin-bottom: 0.15rem; }
.cc-modal-detail-value { font-family: 'Libre Baskerville', serif; font-size: 0.82rem; color: var(--ink); margin-bottom: 0.5rem; }
.cc-modal-badge { display: inline-block; font-family: 'IM Fell English', serif; font-size: 0.7rem; color: var(--ink); border: 1.5px solid var(--ink); padding: 0.15rem 0.5rem; margin-top: 0.3rem; letter-spacing: 0.04em; }

/* ── CONFETTI ── */
.confetti-container { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1000; overflow: hidden; }
.confetti-piece { position: absolute; top: -10px; animation: confettiFall linear forwards; }
@keyframes confettiFall { 0% { transform: translateY(0) rotate(0deg); opacity: 1; } 85% { opacity: 1; } 100% { transform: translateY(110vh) rotate(540deg); opacity: 0; } }
</style>
</head>
<body>

<div class="confetti-container" id="confettiContainer"></div>

<!-- MODAL -->
<div class="cc-modal-backdrop" id="ccModalBackdrop" onclick="closeModal(event)">
  <div class="cc-modal">
    <div class="cc-modal-bar" id="ccModalBar"></div>
    <button class="cc-modal-close" onclick="closeModalBtn()">✕</button>
    <div class="cc-modal-inner">
      <div id="ccModalStreet" class="cc-modal-street"></div>
      <div id="ccModalTitle" class="cc-modal-title"></div>
      <div id="ccModalProduct" class="cc-modal-product"></div>
      <hr class="cc-modal-divider">
      <div class="cc-modal-detail-label">Challenge</div>
      <div id="ccModalChallenge" class="cc-modal-detail-value"></div>
      <div class="cc-modal-detail-label">Completed</div>
      <div id="ccModalDate" class="cc-modal-detail-value"></div>
      <div><span class="cc-modal-badge">✦ Challenge Complete ✦</span></div>
    </div>
  </div>
</div>

<!-- HEADER -->
<header class="page-header">
  <div class="page-title">Project <span>Panopoly</span></div>
  <div class="page-sub">A Panning Challenge · Round 1</div>
  <div class="page-links">
    <a class="page-link" href="https://anjelabug.github.io/project-panjela" target="_blank">← Main Page</a>
    <a class="page-link" href="https://sites.google.com/view/projectpanopoly" target="_blank">Rules · Project Panopoly</a>
    <a class="page-link" href="https://www.youtube.com/@theimpulsivepanner" target="_blank">@theimpulsivepanner</a>
  </div>
  <div class="creator-credit">A panning challenge created by <a href="https://www.youtube.com/@theimpulsivepanner" target="_blank">Jami (@theimpulsivepanner)</a> on YouTube</div>
  <div class="round-badge" id="roundBadge">Round 1</div>
</header>

<!-- OVERALL PROGRESS -->
<div class="round-summary">
  <div class="round-summary-label">Round Progress</div>
  <div class="round-summary-bar-wrap"><div class="round-summary-bar" id="overallBar"></div></div>
  <div class="round-summary-pct" id="overallPct">—</div>
</div>

<!-- ══ ORANGE · Wheel 6 · Bold Look ══ -->
<div class="color-group-header">
  <div class="color-group-swatch" style="background:var(--orange)"></div>
  <div class="color-group-name">Orange · Wheel 6 · New York Ave. / St. James Place</div>
  <div class="color-group-status">1 of 3 properties</div>
</div>

<div class="property-card" id="card-bold">
  <div class="deed-color-bar bar-orange" onclick="toggleCard('bold')">
    <div><div class="group-label">Wheel 6 · Challenge Activity</div><div class="property-name">New York Avenue</div></div>
    <div class="chevron">▾</div>
  </div>
  <div class="deed-header">
    <div class="deed-title">Bold Look</div>
    <div class="deed-subtitle">e.l.f. Sheer Slick · Black Cherry</div>
    <div class="deed-buildings" id="buildings-bold"></div>
    <div class="deed-progress-wrap">
      <div class="deed-progress-track"><div class="deed-progress-fill" id="bar-bold" style="background:var(--orange);width:0%"></div></div>
      <div class="deed-progress-count" id="count-bold">0 / 10</div>
    </div>
  </div>
  <div class="deed-body">
    <div class="deed-section">
      <div class="deed-section-label">Challenge</div>
      <div class="deed-description">Bold Look — create a bold look that is out of your comfort zone.</div>
      <div class="deed-detail">Wheel 6 · 10 uses · Dark berry/burgundy lip as bold look anchor.</div>
    </div>
    <div class="deed-section">
      <div class="deed-section-label">Product Details</div>
      <div class="deed-grid">
        <div class="deed-grid-label">Brand</div><div class="deed-grid-value">e.l.f. Cosmetics</div>
        <div class="deed-grid-label">Product</div><div class="deed-grid-value">Sheer Slick Lipstick</div>
        <div class="deed-grid-label">Shade</div><div class="deed-grid-value">Black Cherry</div>
        <div class="deed-grid-label">Started</div><div class="deed-grid-value">—</div>
      </div>
    </div>
    <div class="deed-section">
      <div class="deed-section-label">Uses · Target 10</div>
      <div class="deed-counter-wrap">
        <button class="deed-btn" onclick="adjustCount('bold',-1)">−</button>
        <div class="deed-counter-display"><div class="deed-counter-number" id="num-bold">0</div><div class="deed-counter-target">of 10 uses</div></div>
        <button class="deed-btn" onclick="adjustCount('bold',1)">+</button>
      </div>
      <div class="deed-last-used" id="last-bold"></div>
      <div class="deed-full-progress">
        <div class="deed-full-track"><div class="deed-full-fill" id="fill-bold" style="background:var(--orange);width:0%"></div></div>
        <div class="deed-full-labels"><span id="pct-bold">0%</span><span>10 uses</span></div>
      </div>
    </div>
    <div class="deed-section">
      <div class="deed-section-label">Notes Log</div>
      <div class="deed-notes-log" id="log-bold"><div class="deed-note-empty">No notes yet.</div></div>
      <div class="deed-note-row">
        <textarea class="deed-note-input" id="input-bold" placeholder="Add a note…" rows="2"></textarea>
        <button class="deed-note-submit" onclick="addNote('bold')">Add</button>
      </div>
    </div>
    <div class="deed-complete">
      <div class="deed-complete-msg">✦ Challenge Complete! ✦</div>
      <div class="deed-complete-sub">You're now the proud owner of Black Cherry from the Bold Look collection! Roll again to find out what you'll collect next!</div>
    </div>
  </div>
</div>

<!-- ══ MAGENTA · Wheel 4 · Blush + Cream Product ══ -->
<div class="color-group-header">
  <div class="color-group-swatch" style="background:var(--magenta)"></div>
  <div class="color-group-name">Pink · Wheel 4 · St. Charles Place / St. James Place</div>
  <div class="color-group-status">2 of 3 properties</div>
</div>

<div class="property-card" id="card-blush">
  <div class="deed-color-bar bar-magenta" onclick="toggleCard('blush')">
    <div><div class="group-label">Wheel 4 · Face Color Products</div><div class="property-name">St. Charles Place</div></div>
    <div class="chevron">▾</div>
  </div>
  <div class="deed-header">
    <div class="deed-title">Blush</div>
    <div class="deed-subtitle">Rare Beauty · Soft Pinch Liquid Blush · Spirited</div>
    <div class="deed-buildings" id="buildings-blush"></div>
    <div class="deed-progress-wrap">

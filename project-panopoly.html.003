<!-- ══ COLLECTED CARDS ══ -->
<div class="collected-section">
  <div class="collected-caption">Properties Acquired · Challenges Completed</div>
  <div class="collected-table">

    <!-- Connecticut Ave · Setting Spray -->
    <div class="collected-card" onclick="openModal({bar:'var(--cyan)',street:'Connecticut Avenue · Light Blue',title:'Setting Spray',product:'One/Size Powder Melt Glass Setting Spray',challenge:'Test and evaluate a spray product across 10 uses.',completed:'5/18/2026'})">
      <div class="cc-color-bar" style="background:var(--cyan)"></div>
      <div class="cc-body">
        <div class="cc-challenge">Setting Spray</div>
        <div class="cc-product">One/Size Powder Melt</div>
        <div class="cc-street">Connecticut Ave.</div>
        <div class="cc-stamp">✦</div>
      </div>
    </div>

    <!-- Boardwalk · Eye Product -->
    <div class="collected-card" onclick="openModal({bar:'var(--darkblue)',street:'Boardwalk · Dark Blue',title:'Eye Product',product:'About-Face Shadow Primer',challenge:'Use and evaluate an eye primer across 7 wears.',completed:'5/18/2026'})">
      <div class="cc-color-bar" style="background:var(--darkblue)"></div>
      <div class="cc-body">
        <div class="cc-challenge">Eye Product</div>
        <div class="cc-product">About-Face Shadow Primer</div>
        <div class="cc-street">Boardwalk</div>
        <div class="cc-stamp">✦</div>
      </div>
    </div>

  </div>
</div>

<footer style="text-align:center;margin-top:3rem;font-size:0.5rem;letter-spacing:0.12em;color:rgba(245,240,232,0.15);text-transform:uppercase;font-family:'DM Mono',monospace;">
  Project Panopoly · Round 1 · anjelabug.github.io/project-panjela
</footer>

<script>
const TARGETS = { bold:10, blush:20, leastused:5, mostused:10, cream:10 };
const KEY = 'project-panopoly-r1';

function load() { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } }
function save(d) { try { localStorage.setItem(KEY, JSON.stringify(d)); } catch {} }

function seedHistoricalData() {
  const d = load();
  if (Object.keys(d).length === 0) {
    save({
      bold:      { count: 8, lastUsed: '5/18/2026', notes: [] },
      blush:     { count: 4, lastUsed: '5/18/2026', notes: [] },
      leastused: { count: 2, lastUsed: '5/18/2026', notes: [] },
      mostused:  { count: 0, lastUsed: null,         notes: [] },
      cream:     { count: 0, lastUsed: null,         notes: [] },
    });
  }
}

function toggleCard(id) { document.getElementById('card-'+id).classList.toggle('open'); }

function adjustCount(id, delta) {
  const d = load();
  if (!d[id]) d[id] = { count:0, notes:[], lastUsed:null };
  d[id].count = Math.max(0, (d[id].count||0) + delta);
  if (delta > 0) { const n=new Date(); d[id].lastUsed=(n.getMonth()+1)+'/'+n.getDate()+'/'+n.getFullYear(); }
  save(d); renderCard(id, d[id]); updateOverall();
  if (delta > 0 && d[id].count >= TARGETS[id]) celebrate(id);
}

function addNote(id) {
  const inp = document.getElementById('input-'+id);
  const text = inp.value.trim(); if (!text) return;
  const d = load();
  if (!d[id]) d[id] = { count:0, notes:[], lastUsed:null };
  if (!d[id].notes) d[id].notes = [];
  const n=new Date();
  const ts=(n.getMonth()+1)+'/'+n.getDate()+'/'+n.getFullYear()+' '+n.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
  d[id].notes.push({ts,text}); save(d); inp.value=''; renderNotes(id, d[id].notes);
}

function renderCard(id, data) {
  const count = data.count||0;
  const target = TARGETS[id];
  const pct = Math.min(100, Math.round(count/target*100));
  document.getElementById('num-'+id).textContent = count;
  document.getElementById('count-'+id).textContent = count+' / '+target;
  document.getElementById('bar-'+id).style.width = pct+'%';
  document.getElementById('fill-'+id).style.width = pct+'%';
  document.getElementById('pct-'+id).textContent = pct+'%';
  const le = document.getElementById('last-'+id);
  if (le) le.textContent = data.lastUsed ? 'Last used '+data.lastUsed : '';
  document.getElementById('card-'+id).classList.toggle('complete', count >= target);
  renderNotes(id, data.notes||[]);
}

function renderNotes(id, notes) {
  const log = document.getElementById('log-'+id); if (!log) return;
  if (!notes||!notes.length) { log.innerHTML='<div class="deed-note-empty">No notes yet.</div>'; return; }
  log.innerHTML = notes.map(n=>`<div class="deed-note-entry"><div class="deed-note-ts">${n.ts}</div><div class="deed-note-text">${esc(n.text)}</div></div>`).join('');
  log.scrollTop = log.scrollHeight;
}

function esc(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function updateOverall() {
  const d = load();
  let total=0, current=0;
  Object.keys(TARGETS).forEach(id => {
    total += TARGETS[id];
    current += Math.min((d[id]&&d[id].count)||0, TARGETS[id]);
  });
  const pct = total>0 ? Math.round(current/total*100) : 0;
  document.getElementById('overallBar').style.width = pct+'%';
  document.getElementById('overallPct').textContent = pct+'%';
}

function openModal(info) {
  document.getElementById('ccModalBar').style.background = info.bar;
  document.getElementById('ccModalStreet').textContent = info.street;
  document.getElementById('ccModalTitle').textContent = info.title;
  document.getElementById('ccModalProduct').textContent = info.product;
  document.getElementById('ccModalChallenge').textContent = info.challenge;
  document.getElementById('ccModalDate').textContent = info.completed;
  document.getElementById('ccModalBackdrop').classList.add('open');
}
function closeModal(e) { if (e.target===document.getElementById('ccModalBackdrop')) closeModalBtn(); }
function closeModalBtn() { document.getElementById('ccModalBackdrop').classList.remove('open'); }

function celebrate(id) {
  const colors=['#6B2D8B','#AAE0FA','#D93A96','#F7941D','#F9E84C','#1B3A8C','#F5F0E8'];
  const container = document.getElementById('confettiContainer');
  for(let i=0;i<50;i++) setTimeout(()=>{
    const p=document.createElement('div'); p.classList.add('confetti-piece');
    p.style.cssText=`left:${Math.random()*100}vw;width:${6+Math.random()*6}px;height:${6+Math.random()*6}px;background:${colors[Math.floor(Math.random()*colors.length)]};border-radius:${Math.random()>0.5?'50%':'1px'};animation-duration:${1.5+Math.random()*2}s;animation-delay:${Math.random()*0.4}s;`;
    container.appendChild(p); setTimeout(()=>p.remove(),4000);
  },i*35);
}

// INIT
seedHistoricalData();
const d = load();
Object.keys(TARGETS).forEach(id => renderCard(id, d[id]||{count:0,notes:[],lastUsed:null}));
updateOverall();
</script>
</body>
</html>

          <option value="nearly">Nearly gone!</option>
          <option value="panned">🫙 Panned!</option>
        </select>
      </div>
      <div class="progress-wrap" style="margin-top:0.6rem;">
        <div class="progress-label-row"><span id="pct-wildcard2">Full</span><span id="last-wildcard2" class="last-used"></span></div>
        <div class="progress-track"><div class="progress-fill red-bar" id="fill-wildcard2" style="width:0%"></div></div>
      </div>
    </div>
    <div class="body-section"><div class="section-title">Notes Log</div><div class="notes-log" id="log-wildcard2"><div class="note-empty">No notes yet.</div></div><div class="notes-input-wrap"><textarea class="notes-input" id="input-wildcard2" placeholder="Add a note…" rows="2"></textarea><button class="note-submit red-submit" onclick="addNote('wildcard2')">Add</button></div></div>
    <div class="complete-overlay"><div class="complete-message">✦ Challenge Complete! ✦</div><div class="complete-sub">Biodance Cera-Nol pads — panned! Draw again!</div></div>
  </div>
</div>


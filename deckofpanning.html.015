        <div class="collected-card red-cc veto-card" onclick="openModal({pip:'♦',cardLabel:'3 of Diamonds',title:'Came in a Set',product:'Tower 28 GetSet Powder Blush · Cranberry Fizz + ShineOn Lip Jelly · Cranberry Frost',notes:'Vetoed via Q♥ Veto. Blush rejected (too warm); gloss formula not enjoyed.',date:'5/19/2026',badge:'veto'})">

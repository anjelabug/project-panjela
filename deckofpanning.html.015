</div>

<footer style="text-align:center;margin-top:2.5rem;font-family:'DM Mono',monospace;font-size:0.48rem;letter-spacing:0.12em;color:rgba(255,255,255,0.15);text-transform:uppercase;">
  Deck of Panning · 2026 · anjelabug.github.io/project-panjela
</footer>

<script>
const CARDS = {
  concealer: { target: 10, isPan: false },
  metallic:  { target: 15, isPan: false },
  blush:     { target: 15, isPan: false },
  precious:  { target: 20, isPan: false },
  slipstick: { target: 12, isPan: false },
  brand:     { target: 20, isPan: false },
  wildcard2: { isPan: true },
};
const PAN_PCT    = { full:0, '75':25, '50':50, '25':75, nearly:90, panned:100 };
const PAN_LABELS = { full:'Full', '75':'~75% remaining', '50':'Halfway!', '25':'~25% remaining', nearly:'Nearly gone!', panned:'🫙 Panned!' };
const KEY = 'deck-of-panning-2026';

function loadData() { try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch { return {}; } }
function saveData(d) { try { localStorage.setItem(KEY, JSON.stringify(d)); } catch {} }

function seedHistoricalData() {
  const d = loadData();
  if (Object.keys(d).length === 0) {
    saveData({
      concealer: { count:0,  lastUsed:null,         notes:[], panLevel:'full' },
      metallic:  { count:2,  lastUsed:'6/2/2026',  notes:[], panLevel:'full' },
      blush:     { count:5,  lastUsed:'6/2/2026',  notes:[], panLevel:'full' },
      precious:  { count:7,  lastUsed:'6/2/2026',  notes:[], panLevel:'full' },
    });
  }
}

function toggleCard(id) { document.getElementById('c-'+id).classList.toggle('open'); }

function adjustCount(id, delta) {
  let d = loadData();
  if (!d[id]) d[id] = { count:0, notes:[], lastUsed:null, panLevel:'full' };
  d[id].count = Math.max(0, (d[id].count||0) + delta);
  if (delta > 0) { const n=new Date(); d[id].lastUsed=(n.getMonth()+1)+'/'+n.getDate()+'/'+n.getFullYear(); }
  saveData(d); renderCard(id, d[id]); updateOverall(d);
  const card = CARDS[id];
  if (!card.isPan && card.target && d[id].count >= card.target && delta > 0) celebrate(id);
  if (card.isPan && d[id].panLevel === 'panned' && delta > 0) celebrate(id);
  checkMetaCard(d);
}


function setPanLevel(id) {
  let d = loadData();
  if (!d[id]) d[id] = { count:0, notes:[], lastUsed:null, panLevel:'full' };
  d[id].panLevel = document.getElementById('pan-'+id).value;
  saveData(d); renderCard(id, d[id]);
  if (d[id].panLevel === 'panned') celebrate(id);
}

function ts() { const n=new Date(); return (n.getMonth()+1)+'/'+n.getDate()+'/'+n.getFullYear()+' '+n.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}); }

function addNote(id) {
  const inp = document.getElementById('input-'+id);
  const text = inp.value.trim(); if (!text) return;
  let d = loadData();
  if (!d[id]) d[id] = { count:0, notes:[], lastUsed:null, panLevel:'full' };
  if (!d[id].notes) d[id].notes = [];
  d[id].notes.push({ ts:ts(), text }); saveData(d); inp.value=''; renderNotes(id, d[id].notes);
}

function renderPanCard(id, data) {
  const count = data.count||0;
  const pl = data.panLevel||'full';
  document.getElementById('num-'+id).textContent = count;
  const le = document.getElementById('last-'+id);
  if (le) le.textContent = data.lastUsed ? 'Last used '+data.lastUsed : '';
  const sel = document.getElementById('pan-'+id);
  if (sel) sel.value = pl;
  const pp = PAN_PCT[pl]||0;
  document.getElementById('fill-'+id).style.width = pp+'%';
  document.getElementById('pct-'+id).textContent = PAN_LABELS[pl]||'Full';
  document.getElementById('bar-'+id).style.width = pp+'%';
  document.getElementById('count-'+id).textContent = count+' uses · '+(PAN_LABELS[pl]||'Full');
  document.getElementById('c-'+id).classList.toggle('complete', pl==='panned');
  renderNotes(id, data.notes||[]);
}

function renderCard(id, data) {
  const card = CARDS[id]; const count = data.count||0;
  if (card.isPan) { renderPanCard(id, data); return; }
  document.getElementById('num-'+id).textContent = count;
  const le = document.getElementById('last-'+id);
  if (le) le.textContent = data.lastUsed ? 'Last used '+data.lastUsed : '';
  const pct = Math.min(100, Math.round(count/card.target*100));
  document.getElementById('fill-'+id).style.width = pct+'%';
  document.getElementById('pct-'+id).textContent = pct+'%';
  document.getElementById('bar-'+id).style.width = pct+'%';
  document.getElementById('count-'+id).textContent = count+' / '+card.target;
  document.getElementById('c-'+id).classList.toggle('complete', count >= card.target);
  renderNotes(id, data.notes||[]);
}

function renderNotes(id, notes) {
  const log = document.getElementById('log-'+id); if (!log) return;
  if (!notes||!notes.length) { log.innerHTML='<div class="note-empty">No notes yet.</div>'; return; }
  log.innerHTML = notes.map(n=>`<div class="note-entry"><div class="note-timestamp">${n.ts}</div><div class="note-text">${esc(n.text)}</div></div>`).join('');
  log.scrollTop = log.scrollHeight;
}

function esc(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function checkMetaCard(d) {
  const blushDone = (d.blush && d.blush.count >= 15);
  const meta = document.getElementById('meta-pickup');
  if (meta) meta.classList.toggle('earned', blushDone);
}

function updateOverall(d) {
  // Overall progress bar removed — rolling challenge
}

function openModal(info) {
  document.getElementById('ccModalPip').textContent = info.pip;
  document.getElementById('ccModalPip').style.color = (info.pip==='♥'||info.pip==='♦') ? '#b91c1c' : '#1a1410';
  document.getElementById('ccModalCardLabel').textContent = info.cardLabel;
  document.getElementById('ccModalTitle').textContent = info.title;
  document.getElementById('ccModalProduct').textContent = info.product;
  document.getElementById('ccModalChallenge').textContent = info.notes;
  document.getElementById('ccModalDate').textContent = info.date;
  const badge = document.getElementById('ccModalBadge');
  if (info.badge === 'veto') { badge.textContent = '✕ Challenge Vetoed'; badge.className = 'cc-modal-badge badge-veto'; document.getElementById('ccModalNotesLabel').textContent = 'Notes'; }
  else { badge.textContent = '✦ Challenge Complete ✦'; badge.className = 'cc-modal-badge badge-complete'; document.getElementById('ccModalNotesLabel').textContent = 'Notes'; }
  document.getElementById('ccModalBackdrop').classList.add('open');
}
function closeModal(e) { if (e.target===document.getElementById('ccModalBackdrop')) closeModalBtn(); }
function closeModalBtn() { document.getElementById('ccModalBackdrop').classList.remove('open'); }

function celebrate(id) {
  const c=document.getElementById('confettiContainer');
  const colors=['#b91c1c','#e8c84a','#1a3a2a','#fdf8f2','#8b3050','#b8962a'];
  const suits=['♠','♥','♣','♦'];
  for(let i=0;i<60;i++) setTimeout(()=>{
    const p=document.createElement('div'); p.classList.add('confetti-piece');
    if(Math.random()>0.6){p.style.cssText=`background:none;font-size:14px;width:auto;height:auto;color:${colors[Math.floor(Math.random()*colors.length)]}`;p.textContent=suits[Math.floor(Math.random()*suits.length)];}
    else{p.style.background=colors[Math.floor(Math.random()*colors.length)];p.style.borderRadius=Math.random()>0.5?'50%':'1px';}
    p.style.left=Math.random()*100+'vw';p.style.animationDuration=(1.5+Math.random()*2)+'s';p.style.animationDelay=(Math.random()*0.5)+'s';
    c.appendChild(p);setTimeout(()=>p.remove(),4000);
  },i*30);
}

// SLIPSTICK shade counters
const SHADES = ['mauve','pink','jam','cherry'];

function getSlipstickData() {
  let d = loadData();
  if (!d.slipstick) d.slipstick = { count:0, notes:[], lastUsed:null, panLevel:'full' };
  if (!d.slipstick.shades) d.slipstick.shades = { mauve:0, pink:0, jam:0, cherry:0 };
  return d;
}

function renderSlipstickShades(shades) {
  SHADES.forEach(s => {
    const n = shades[s] || 0;
    document.getElementById('num-'+s).textContent = n;
    const minEl = document.getElementById('min-'+s);
    if (n >= 1) {
      minEl.textContent = '✓ used';
      minEl.style.color = '#14532d';
    } else {
      minEl.textContent = '⚠ min. 1 needed';
      minEl.style.color = 'var(--text-muted)';
    }
  });
}

function adjustShade(shade, delta) {
  let d = getSlipstickData();
  const prev = d.slipstick.shades[shade] || 0;
  const newVal = Math.max(0, prev + delta);
  const diff = newVal - prev;
  if (diff === 0) return;
  d.slipstick.shades[shade] = newVal;
  d.slipstick.count = Math.max(0, (d.slipstick.count || 0) + diff);
  if (diff > 0) { const n=new Date(); d.slipstick.lastUsed=(n.getMonth()+1)+'/'+n.getDate()+'/'+n.getFullYear(); }
  saveData(d);
  renderCard('slipstick', d.slipstick);
  renderSlipstickShades(d.slipstick.shades);
  if (d.slipstick.count >= 12 && diff > 0) celebrate('slipstick');
}

function adjustSlipstickTotal(delta) {
  let d = getSlipstickData();
  d.slipstick.count = Math.max(0, (d.slipstick.count || 0) + delta);
  if (delta > 0) { const n=new Date(); d.slipstick.lastUsed=(n.getMonth()+1)+'/'+n.getDate()+'/'+n.getFullYear(); }
  saveData(d);
  renderCard('slipstick', d.slipstick);
  if (d.slipstick.count >= 12 && delta > 0) celebrate('slipstick');
}

// INIT
seedHistoricalData();
const d = loadData();
Object.keys(CARDS).forEach(id => renderCard(id, d[id]||{count:0,notes:[],lastUsed:null,panLevel:'full'}));
if (d.slipstick && d.slipstick.shades) renderSlipstickShades(d.slipstick.shades);
else renderSlipstickShades({ mauve:0, pink:0, jam:0, cherry:0 });
updateOverall(d);
checkMetaCard(d);
</script>
</body>
</html>
